# ===== Appwrite (필수) =====
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=
NEXT_PUBLIC_APPWRITE_COLLECTION_ID=assets
NEXT_PUBLIC_APPWRITE_CALENDAR_COLLECTION_ID=calendar

# ===== 트래킹 / 검증 (선택 — 값을 넣으면 자동 활성화, 비우면 코드 자체가 안 붙음) =====

# Google Analytics 4 측정 ID (예: G-XXXXXXXXXX)
# analytics.google.com → 관리 → 데이터 스트림 → 웹 스트림에서 확인
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity 프로젝트 ID (예: abcd1234ef)
# clarity.microsoft.com → 프로젝트 → Settings → Overview에서 확인
NEXT_PUBLIC_CLARITY_ID=

# Google Search Console 소유권 확인 코드 (HTML 태그 방식의 content 값만)
# <meta name="google-site-verification" content="이부분" />
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# 네이버 서치어드바이저 소유권 확인 코드 (HTML 태그 방식의 content 값만)
# <meta name="naver-site-verification" content="이부분" />
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
